# MongoDB connection string (Atlas or local), e.g.
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/sample_mflix
MONGODB_URI=

# Database the agent queries against
DATABASE_NAME=sample_mflix

# Groq API key and model configuration
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
LLM_TEMPERATURE=0
TOP_K=5